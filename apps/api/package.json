{
    "name": "@distroai/api",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "nest build",
        "dev": "nest start --watch",
        "start": "node dist/apps/api/src/main",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:e2e": "jest --config ./test/jest-e2e.json"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1001.0",
        "@aws-sdk/s3-request-presigner": "^3.1001.0",
        "@bull-board/api": "^6.20.3",
        "@bull-board/express": "^6.20.3",
        "@distroai/db": "workspace:*",
        "@distroai/types": "workspace:*",
        "@distroai/utils": "workspace:*",
        "@langchain/anthropic": "^1.3.22",
        "@langchain/core": "^1.1.30",
        "@langchain/google-genai": "^2.1.26",
        "@langchain/langgraph": "^1.2.0",
        "@langchain/openai": "^1.2.12",
        "@nestjs/bullmq": "^11.0.4",
        "@nestjs/common": "^10.3.8",
        "@nestjs/config": "^3.2.2",
        "@nestjs/core": "^10.3.8",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.3.8",
        "@nestjs/schedule": "^4.1.2",
        "@nestjs/swagger": "^7.3.1",
        "@nestjs/terminus": "^10.2.3",
        "@nestjs/throttler": "^6.0.0",
        "@react-email/components": "^1.0.8",
        "@react-email/render": "^2.0.4",
        "@react-pdf/renderer": "^4.3.2",
        "@sentry/node": "^8.0.0",
        "axios": "^1.13.6",
        "bcrypt": "^5.1.1",
        "bullmq": "^5.70.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "date-fns-tz": "^3.2.0",
        "fast-csv": "^5.0.5",
        "firebase-admin": "^13.7.0",
        "form-data": "^4.0.5",
        "helmet": "^7.1.0",
        "ioredis": "^5.3.2",
        "joi": "^17.13.1",
        "langchain": "^1.2.29",
        "openai": "^6.25.0",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "passport-jwt": "^4.0.1",
        "prom-client": "^15.1.0",
        "qrcode": "^1.5.4",
        "razorpay": "^2.9.6",
        "react": "^19.2.4",
        "reflect-metadata": "^0.2.2",
        "resend": "^6.9.3",
        "rxjs": "^7.8.1",
        "uuid": "^13.0.0",
        "xlsx": "^0.18.5",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@distroai/config": "workspace:*",
        "@nestjs/cli": "^10.3.2",
        "@nestjs/schematics": "^10.1.1",
        "@nestjs/testing": "^10.3.8",
        "@types/bcrypt": "^5.0.2",
        "@types/express": "^4.17.21",
        "@types/jest": "^30.0.0",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.14.2",
        "@types/passport-google-oauth20": "^2.0.17",
        "@types/passport-jwt": "^4.0.1",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.2.14",
        "@types/supertest": "^6.0.2",
        "@types/uuid": "^11.0.0",
        "supertest": "^7.0.0",
        "ts-jest": "^29.1.4",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.4.5"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}