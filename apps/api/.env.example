# DistroAI API — Environment Variables

# Core
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://distroai:distroai@localhost:5433/distroai?schema=public
REDIS_URL=redis://localhost:6380
CORS_ORIGINS=http://localhost:3001

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Queue (Bull Board admin UI)
ADMIN_KEY=your-admin-key-for-bull-board

# WhatsApp Business API
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AWS S3 (falls back to local filesystem if not configured)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=distroai-dev

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Email (Resend — falls back to console if not configured)
RESEND_API_KEY=
FROM_EMAIL=noreply@distroai.in

# SMS (MSG91 — falls back to console if not configured)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=DISTRO

# Firebase Cloud Messaging (falls back to console if not configured)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# GST E-Invoice NIC (falls back to mock if not configured)
NIC_EINVOICE_URL=https://einv-apisandbox.nic.in
NIC_EINVOICE_USERNAME=
NIC_EINVOICE_PASSWORD=
