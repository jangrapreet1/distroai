# =========================================================
# Stage 1: Multi-Arch WAL-G Resolver (x86_64 + aarch64/ARM64)
# Compatible with Oracle Cloud Ampere A1 Free Tier & x86 VPS
# =========================================================
FROM golang:1.22-alpine AS walg-builder
ARG TARGETARCH
WORKDIR /src
RUN apk add --no-cache git make curl bash

RUN if [ "$TARGETARCH" = "arm64" ] || [ "$(uname -m)" = "aarch64" ]; then \
        echo "Building WAL-G for ARM64/aarch64..." && \
        CGO_ENABLED=0 go install github.com/wal-g/wal-g/cmd/pg@v3.0.4 && \
        mv /go/bin/pg /wal-g; \
    else \
        echo "Downloading WAL-G prebuilt for AMD64..." && \
        curl -L "https://github.com/wal-g/wal-g/releases/download/v2.0.1/wal-g-pg-ubuntu-20.04-amd64.tar.gz" -o /tmp/wal-g.tar.gz && \
        tar -xvzf /tmp/wal-g.tar.gz -C /tmp && \
        mv /tmp/wal-g-pg-ubuntu-20.04-amd64 /wal-g; \
    fi && chmod +x /wal-g

# =========================================================
# Stage 2: Production PostgreSQL with pgvector & WAL-G
# =========================================================
FROM pgvector/pgvector:pg15

# Install dependencies and cron
RUN apt-get update && apt-get install -y curl cron ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy multi-arch compiled WAL-G binary
COPY --from=walg-builder /wal-g /usr/local/bin/wal-g

# Setup nightly base backup cron (Runs at 3:00 AM everyday)
# Exports container's environment variables to /etc/wal-g.env on entry so cron can access B2 keys
RUN echo "0 3 * * * postgres bash -c 'export \$(cat /etc/wal-g.env | xargs) && wal-g backup-push /var/lib/postgresql/data >> /var/log/wal-g.log 2>&1'" > /etc/cron.d/wal-g-backup
RUN chmod 0644 /etc/cron.d/wal-g-backup
RUN crontab -u postgres /etc/cron.d/wal-g-backup

# Add custom entrypoint to kick off cron
COPY postgres-entrypoint-walg.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/postgres-entrypoint-walg.sh

ENTRYPOINT ["postgres-entrypoint-walg.sh"]
CMD ["postgres"]
