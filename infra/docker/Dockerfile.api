# =========================================================
# Stage 1: Builder — install deps + compile TypeScript
# =========================================================
FROM node:20-alpine AS builder
WORKDIR /app

# Use hoisted node_modules so symlinks survive Docker COPY
RUN echo "node-linker=hoisted" > .npmrc

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

RUN npm install -g pnpm && pnpm install --frozen-lockfile
RUN cd apps/api && pnpm run build
RUN npx -y tsc-alias -p apps/api/tsconfig.json

# =========================================================
# Stage 2: Runner — minimal production image
# =========================================================
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
RUN apk add --no-cache openssl && \
    addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs

# Copy compiled output
COPY --from=builder /app/apps/api/dist ./dist
COPY --from=builder /app/apps/api/package.json ./package.json

# Copy hoisted (flat) node_modules from root — no broken symlinks
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/ ./packages/

USER nestjs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/health || exit 1

CMD ["node", "dist/apps/api/src/main.js"]
