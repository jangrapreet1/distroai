# =========================================================
# Stage 1: Builder — install deps + build Next.js standalone
# =========================================================
FROM node:20-slim AS builder
WORKDIR /app

# Native build deps and corepack setup
RUN apt-get update && apt-get install -y python3 make g++ openssl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.1.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/ ./packages/
COPY apps/ ./apps/

RUN pnpm install --frozen-lockfile

# Next.js standalone output mode
ARG API_INTERNAL_URL
ARG NEXT_PUBLIC_META_APP_ID
ENV API_INTERNAL_URL=$API_INTERNAL_URL
ENV NEXT_PUBLIC_META_APP_ID=$NEXT_PUBLIC_META_APP_ID
ENV NEXT_TELEMETRY_DISABLED=1
RUN cd apps/web && pnpm run build

# =========================================================
# Stage 2: Runner — serve Next.js standalone
# =========================================================
FROM node:20-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN apt-get update && apt-get install -y curl ca-certificates && rm -rf /var/lib/apt/lists/* && \
    groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 -g nodejs nextjs

# In a pnpm monorepo, standalone output preserves the workspace structure:
#   .next/standalone/apps/web/server.js (the entry point)
#   .next/standalone/node_modules/      (root hoisted deps)
#   .next/standalone/apps/web/node_modules/ (app-specific deps)
# We copy the entire standalone tree and then add static + public assets.
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

USER nextjs
EXPOSE 3001

ENV PORT=3001
ENV HOSTNAME="0.0.0.0"

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3001/ || exit 1

CMD ["node", "apps/web/server.js"]
