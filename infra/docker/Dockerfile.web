# =========================================================
# Stage 1: Builder — install deps + build Next.js standalone
# =========================================================
FROM node:20-alpine AS builder
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

RUN npm install -g pnpm && pnpm install --frozen-lockfile

# Next.js standalone output mode
ARG API_INTERNAL_URL
ENV API_INTERNAL_URL=$API_INTERNAL_URL
ENV NEXT_TELEMETRY_DISABLED=1
RUN cd apps/web && pnpm run build

# =========================================================
# Stage 2: Runner — serve Next.js standalone
# =========================================================
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# In a pnpm monorepo, standalone output preserves the workspace structure:
#   .next/standalone/apps/web/server.js (the entry point)
#   .next/standalone/node_modules/      (root hoisted deps)
#   .next/standalone/apps/web/node_modules/ (app-specific deps)
# We copy the entire standalone tree and then add static + public assets.
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

USER nextjs
EXPOSE 3001

ENV PORT=3001
ENV HOSTNAME="0.0.0.0"

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3001/ || exit 1

CMD ["node", "apps/web/server.js"]
