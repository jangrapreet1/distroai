# =========================================================
# Worker — same build as API, different entrypoint
# Runs BullMQ queue processors only (no HTTP server)
# =========================================================
FROM node:20-alpine AS builder
WORKDIR /app

# Use hoisted node_modules so symlinks survive Docker COPY
RUN echo "node-linker=hoisted" > .npmrc

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

RUN npm install -g pnpm && pnpm install --frozen-lockfile
RUN npx prisma generate --schema=packages/db/prisma/schema.prisma
RUN cd apps/api && pnpm run build
RUN npx -y tsc-alias -p apps/api/tsconfig.json

# =========================================================
# Runner
# =========================================================
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
RUN apk add --no-cache openssl && \
    addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs

# Copy compiled output
COPY --chown=nestjs:nodejs --from=builder /app/apps/api/dist ./dist
COPY --chown=nestjs:nodejs --from=builder /app/apps/api/package.json ./package.json

# Copy hoisted (flat) node_modules from root — no broken symlinks
COPY --chown=nestjs:nodejs --from=builder /app/node_modules ./node_modules
COPY --chown=nestjs:nodejs --from=builder /app/packages/ ./packages/

USER nestjs

# No EXPOSE — worker doesn't serve HTTP
# No HEALTHCHECK — managed via K8s liveness exec probes

CMD ["node", "dist/apps/api/src/worker.main.js"]
