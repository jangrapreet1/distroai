# ─────────────────────────────────────────────────────────
# DistroAI — Production Environment Variables
# Copy this file to .env.production and fill in values
# ─────────────────────────────────────────────────────────

# ─── Domain ───────────────────────────────────────────────
DOMAIN=yourdomain.com

# ─── Database ─────────────────────────────────────────────
POSTGRES_USER=distroai
POSTGRES_PASSWORD=CHANGE_ME_to_a_strong_password
POSTGRES_DB=distroai

# ─── WAL-G Point-in-Time Recovery (Backblaze B2) ──────────
WALG_S3_PREFIX=s3://distroai-prod-backups/walg
AWS_ACCESS_KEY_ID_B2=your_b2_application_key_id
AWS_SECRET_ACCESS_KEY_B2=your_b2_application_key
AWS_ENDPOINT_B2=https://s3.us-west-004.backblazeb2.com
AWS_REGION_B2=us-west-004

# ─── JWT Auth ─────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_random_64_char_string
JWT_REFRESH_SECRET=CHANGE_ME_another_random_64_char_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Admin ────────────────────────────────────────────────
ADMIN_KEY=CHANGE_ME_admin_api_key

# ─── WhatsApp Business API (optional) ────────────────────
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# ─── Razorpay (optional) ─────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Email — Resend (optional) ───────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ─── SMS — MSG91 (optional) ──────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=DSTRAI
MSG91_TEMPLATE_ID=

# ─── Firebase Push (optional) ────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── AWS S3 (optional — uses local storage fallback) ─────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1

# ─── NIC E-Invoice (optional) ────────────────────────────
NIC_EINVOICE_URL=
NIC_EINVOICE_USERNAME=
NIC_EINVOICE_PASSWORD=
NIC_EINVOICE_CLIENT_ID=
NIC_EINVOICE_CLIENT_SECRET=
NIC_EINVOICE_GSTIN=

# ─── AI (optional — Phase 5) ─────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_SERVICE_URL=http://ai-service:8000

# ─── Sentry (optional) ───────────────────────────────────
SENTRY_DSN=

# ─── Google Auth (optional) ─────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/v1/auth/google/callback
