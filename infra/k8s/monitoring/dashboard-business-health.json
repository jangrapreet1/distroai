{
    "dashboard": {
        "title": "DistroAI — Business Health",
        "uid": "distroai-business-health",
        "timezone": "Asia/Kolkata",
        "refresh": "1m",
        "panels": [
            {
                "title": "New Org Signups / Day",
                "type": "timeseries",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "increase(active_orgs_total[24h])",
                        "legendFormat": "New orgs"
                    }
                ]
            },
            {
                "title": "Active Organizations",
                "type": "stat",
                "gridPos": {
                    "h": 4,
                    "w": 6,
                    "x": 12,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "active_orgs_total"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "thresholds": {
                            "steps": [
                                {
                                    "color": "blue",
                                    "value": 0
                                }
                            ]
                        }
                    }
                }
            },
            {
                "title": "Daily Active Orgs",
                "type": "stat",
                "gridPos": {
                    "h": 4,
                    "w": 6,
                    "x": 18,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "count(count by (org_plan) (orders_created_total))"
                    }
                ]
            },
            {
                "title": "Plan Distribution",
                "type": "piechart",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 4
                },
                "targets": [
                    {
                        "expr": "count by (org_plan) (orders_created_total)",
                        "legendFormat": "{{ org_plan }}"
                    }
                ]
            },
            {
                "title": "WhatsApp Messages Sent / Received",
                "type": "timeseries",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 8
                },
                "targets": [
                    {
                        "expr": "rate(whatsapp_messages_total{direction='outbound'}[5m]) * 60",
                        "legendFormat": "Sent"
                    },
                    {
                        "expr": "rate(whatsapp_messages_total{direction='inbound'}[5m]) * 60",
                        "legendFormat": "Received"
                    }
                ]
            },
            {
                "title": "Invoice Generation Rate",
                "type": "timeseries",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 12
                },
                "targets": [
                    {
                        "expr": "rate(orders_created_total[1h]) * 3600",
                        "legendFormat": "Orders/hour"
                    }
                ]
            }
        ]
    }
}